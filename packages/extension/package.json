    "configuration": {
      "title": "AIDLC Workspace",
      "properties": {
        "aidlc.autopilot.enabled": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "🚧 **Task pre-planning experiment.** When enabled, New Task collects project context and generates a recommended plan (`context.json` + `autopilot-plan.md`) before its selected pipeline runs. Off by default."
        },
        "aidlc.tokenMonitor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show a status bar item with today/this-month Claude token spend, parsed from ~/.claude/projects logs."
        },
        "aidlc.tokenMonitor.refreshSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "How often to re-scan ~/.claude/projects for new usage records (seconds, minimum 15)."
        },
        "aidlc.tokenMonitor.suggestionWindowDays": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "description": "Window the cost-suggestion engine scans (in days). Older logs are skipped — they don't reflect current habits."
        },
        "aidlc.monitor.pollIntervalSeconds": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "maximum": 300,
          "description": "How often the Monitor panel polls the agents-observe server (GET /api/status), in seconds."
        },
        "aidlc.astGraph.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Auto-download the ast-graph CLI, scan the workspace in the background, and register it as a Claude MCP server so Claude can read structural code context cheaply."
        },
        "aidlc.astGraph.autoRescanDebounceSeconds": {
          "type": "number",
          "default": 5,
          "minimum": 1,
          "description": "Debounce window for incremental rescans after source files change (seconds)."
        },
        "aidlc.mcp.listTimeoutSeconds": {
          "type": "number",
          "default": 90,
          "minimum": 5,
          "description": "Timeout (seconds) for `claude mcp list` in the MCP Servers panel. Claude health-checks every configured server, so raise this if you have many remote/unauthenticated servers and see a timeout."
        },
        "aidlc.workspace.epicsDirectory": {
          "type": "string",
          "default": "docs/epics",
          "description": "Relative path (from the project root) where task workspaces are stored. Changing this updates `state.root` in workspace.yaml. The Tasks view and New Task wizard use this directory immediately.",
          "scope": "resource"
        },
        "aidlc.displayLanguage": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi"
          ],
          "default": "auto",
          "description": "Language for AIDLC interface labels and AI-authored Markdown artifacts. Auto follows VS Code's display language."
        },
        "aidlc.jira.site": {
          "type": "string",
          "default": "",
          "description": "Jira Cloud site, e.g. acme.atlassian.net. The API token is stored in VS Code SecretStorage, never here."
        },
        "aidlc.jira.email": {
          "type": "string",
          "default": "",
          "description": "Email of the Atlassian account used for Jira API calls."
        },
        "aidlc.jira.projectKey": {
          "type": "string",
          "default": "",
          "description": "Optional Jira project key used to find the board (e.g. ACME)."
        },
        "aidlc.jira.boardId": {
          "type": "number",
          "default": 0,
          "description": "Scrum board id to read sprints from. 0 = pick the first board the account can see."
        },
        "aidlc.jira.jql": {
          "type": "string",
          "default": "",
          "description": "Optional JQL override for the Sprint tab. When set it replaces the default \"assignee = currentUser() AND sprint IN openSprints()\" query entirely."
        },
        "aidlc.jira.refreshMinutes": {
          "type": "number",
          "default": 10,
          "description": "Minutes before cached sprint data is refetched. 0 disables auto-refresh (manual Refresh only)."
        },
        "aidlc.jira.requestTimeoutSeconds": {
          "type": "number",
          "default": 20,
          "description": "Per-request timeout for Jira and Confluence API calls."
        },
        "aidlc.jira.subtasks.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Allow creating Jira subtasks from the template. Off by default — this writes to your team's board."
        },
        "aidlc.jira.subtasks.templatePath": {
          "type": "string",
          "default": ".aidlc/jira-subtask-template.yaml",
          "description": "Path (relative to the workspace root) of the subtask template YAML."
        },
        "aidlc.jira.subtasks.confluencePageUrl": {
          "type": "string",
          "default": "",
          "description": "Confluence page the subtask template is imported from, for re-import."
        },
        "aidlc.jira.subtasks.issueTypeName": {
          "type": "string",
          "default": "auto",
          "description": "Subtask issue type name. \"auto\" resolves it from the project (the type flagged subtask)."
        },
        "aidlc.jira.subtasks.assignToMe": {
          "type": "boolean",
          "default": true,
          "description": "Assign created subtasks to the authenticated account."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "aidlc.selectDisplayLanguageEnglish",
          "when": "view == aidlcSidebar && aidlc.resolvedDisplayLanguage == en",
          "group": "navigation@-1"
        },
        {
          "command": "aidlc.selectDisplayLanguageVietnamese",
          "when": "view == aidlcSidebar && aidlc.resolvedDisplayLanguage == vi",
          "group": "navigation@-1"
        },
        {
          "command": "aidlc.startProductTour",
          "when": "view == aidlcSidebar",
          "group": "navigation@-0.5"
        },
        {
          "command": "aidlc.openSettings",
          "when": "view == aidlcSidebar",
          "group": "navigation@0"
        }
      ],
      "editor/title": [
        {
          "command": "aidlc.startProductTour",
          "when": "activeWebviewPanelId == 'aidlc.workspace'",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "aidlc.gettingStarted",
        "title": "AIDLC: phát triển và duy trì project",
        "description": "Theo Change từ yêu cầu, qua Epic delivery, đến quyết định cập nhật Project Context.",
        "steps": [
          {
            "id": "aidlc.lifecycle-overview",
            "title": "Một Change là đơn vị công việc",
            "description": "Project, Discover, Sprint và Epic cùng đọc một Change. Impact chỉ là tư vấn: không có bước Confirm impact để khoá việc phát triển.\n\n[Start Product Tour](command:aidlc.startProductTour)"
          },
          {
            "id": "aidlc.capture-change",
            "title": "Capture Change rồi chọn route",
            "description": "Tạo Change từ Project hoặc Discover. Chọn Explore khi cần làm rõ, Start Epic khi scope đủ, hoặc Save/Shelve để giữ lại — mọi route đều có đường tiếp theo.",
            "completionEvents": [
              "onCommand:aidlc.startEpic"
            ]
          },
          {
            "id": "aidlc.start-linked-epic",
            "title": "Start Epic với snapshot",
            "description": "Khi Start Epic từ Change, AIDLC pin Context revision và source snapshot. Điều này tách delivery của bạn khỏi thay đổi đồng đội đang làm.",
            "completionEvents": [
              "onCommand:aidlc.openEpicsList"
            ]
          },
          {
            "id": "aidlc.safe-scan",
            "title": "Scan an toàn như Git",
            "description": "Discover scan tạo một run có source snapshot; Context Proposal là khu vực staging riêng. Review, rebase khi stale, apply hoặc discard có lý do — scan không tự ghi đè Context.",
            "completionEvents": [
              "onCommand:aidlc.openBuilder"
            ]
          },
          {
            "id": "aidlc.close-context-loop",
            "title": "Delivery chỉ Done sau Context",
            "description": "Pipeline hoàn tất chỉ tạo delivery evidence. Một người phải Apply Context Proposal, hoặc ghi rõ “Không cần cập nhật Context”; sau đó Change mới Done.\n\n[Mở Product Tour](command:aidlc.startProductTour)"
          }
        ]
      }
    ]
  },
  "scripts": {
    "copy:templates": "rm -rf templates && cp -R ../core/templates templates",
    "copy:tools": "rm -rf tools && cp -R ../../tools tools",
    "copy:annotron": "rm -rf vendor && mkdir -p vendor && cp -R ../../vendor/annotron vendor/annotron",
    "copy:discovery-guide": "cp ../../docs/DISCOVERY_SHAPE_WORKFLOW.md assets/discovery-shape-workflow.md",
    "compile": "pnpm copy:templates && pnpm copy:tools && pnpm copy:annotron && pnpm copy:discovery-guide && tsc -p ./ && vite build",
    "watch": "trap 'kill 0' SIGINT EXIT; pnpm watch:tsc & pnpm watch:webviews & wait",
    "watch:tsc": "tsc -watch -p ./",
    "watch:webviews": "vite build --watch",
    "typecheck": "tsc -p ./ --noEmit && tsc -p ./tsconfig.webview.json --noEmit",
    "bundle:webviews": "vite build",
    "bundle": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --format=cjs --outfile=out/extension.js",
    "bundle:prod": "esbuild src/extension.ts --bundle --platform=node --target=node18 --external:vscode --format=cjs --minify --outfile=out/extension.js",
    "clean:out": "rm -rf out",
    "test": "vitest run",
    "test:watch": "vitest",
    "package": "pnpm --filter @aidlc/core build && pnpm copy:templates && pnpm copy:tools && pnpm copy:annotron && pnpm copy:discovery-guide && pnpm typecheck && pnpm clean:out && pnpm bundle:webviews && pnpm bundle:prod && vsce package --no-dependencies"
  },
  "dependencies": {
    "@aidlc/core": "workspace:*",
    "js-yaml": "^4.1.1",
    "mermaid": "^11.16.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vscode/vsce": "^3.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "esbuild": "^0.24.0",
    "lucide-react": "^0.453.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.3.0",
    "vite": "^7.3.3",
    "vitest": "^4.1.5"
  }
}
